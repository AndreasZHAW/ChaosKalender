rules_version = '2';

// ChaosKalender – Firestore-Sicherheitsregeln
// Stand: Paket 2 (Login & Registrierung).
// Nur die "users"-Sammlung ist bereits freigeschaltet. Alle anderen
// Sammlungen (Kalender, Nachrichten, Dokumente ...) werden gezielt in den
// nächsten Paketen ergänzt, bis dahin sind sie komplett gesperrt.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return userDoc().data.role;
    }

    function myStatus() {
      return userDoc().data.status;
    }

    function isActive() {
      return isSignedIn() && userDoc().data.status == 'active';
    }

    function isAdmin() {
      return isSignedIn() && isActive() && myRole() == 'admin';
    }

    // --- users ---------------------------------------------------------
    match /users/{userId} {
      // Lesen: eigenes Profil, Admin, oder jede AKTIVE Person (nötig, damit
      // z.B. Andi den Namen/die UID von Janine finden kann, um ihr eine
      // Änderungsanfrage zu schicken). Reine Profildaten, keine Kalenderdaten.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isActive());

      // Registrierung: ein neuer Account legt AUSSCHLIESSLICH sein eigenes
      // Dokument an, zwingend mit status "pending" und OHNE eigene
      // Rollenwahl (die Rolle vergibt ausschließlich der Admin bei der
      // Freischaltung).
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.status == 'pending'
                    && !('role' in request.resource.data);

      // Ändern: Admin darf Status/Rolle setzen (Freischaltung). Die Person
      // selbst darf z. B. die optionale E-Mail-Adresse pflegen, aber nicht
      // ihren eigenen Status oder ihre Rolle selbst hochstufen.
      allow update: if isAdmin() || (
                       isSignedIn() && request.auth.uid == userId &&
                       request.resource.data.status == resource.data.status &&
                       request.resource.data.role  == resource.data.role
                     );

      allow delete: if isAdmin();
    }

    // --- logs: Login-/Geräte-Protokoll --------------------------------
    match /logs/{logId} {
      // Jede angemeldete Person darf einen Log-Eintrag über SICH SELBST
      // anlegen (uid muss der eigenen entsprechen) – nie für andere.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Lesen darf ausschliesslich der Admin (Datenschutz: Geräte-/
      // Nutzungsdaten sind sensibel).
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- slot_changes: Änderungsanfragen zwischen den Elternteilen -----
    match /slot_changes/{changeId} {
      // Lesen: nur die beiden Beteiligten (Anfragende/r + Empfänger/in)
      // oder Admin.
      allow read: if isSignedIn() && (
                     isAdmin() ||
                     request.auth.uid == resource.data.angefragtVonUid ||
                     request.auth.uid == resource.data.angefragtAnUid
                   );
      // Neu anlegen: nur eine aktive Person, und zwar als "angefragtVon"
      // über sich selbst (nicht im Namen anderer).
      allow create: if isSignedIn() && isActive()
                    && request.resource.data.angefragtVonUid == request.auth.uid;
      // Ändern (akzeptieren/ablehnen/gegenvorschlagen): nur die beiden
      // Beteiligten dürfen den Status/Verlauf fortschreiben.
      allow update: if isSignedIn() && (
                       request.auth.uid == resource.data.angefragtVonUid ||
                       request.auth.uid == resource.data.angefragtAnUid
                     );
      allow delete: if isAdmin();
    }

    // --- event_overrides: verschobene/abgesagte Fixtermine (Bandprobe,
    // Volleyball, Clubs, Hort) -------------------------------------
    match /event_overrides/{key} {
      allow read: if isSignedIn() && isActive();
      allow write: if isSignedIn() && isActive() &&
                     (myRole() == 'elternteil' || isAdmin());
    }

    // --- custom_events: frei eintragbare Termine (z.B. "Zahnarzt
    // Janosch"), je nach Kontext direkt sichtbar oder als Anfrage -------
    match /custom_events/{eventId} {
      allow read: if isSignedIn() && isActive();
      allow create: if isSignedIn() && isActive() &&
                     request.resource.data.erstelltVonUid == request.auth.uid;
      allow update: if isSignedIn() && isActive() && (
                       resource.data.erstelltVonUid == request.auth.uid ||
                       resource.data.betroffenUid == request.auth.uid ||
                       isAdmin()
                     );
      allow delete: if isSignedIn() && isActive() &&
                     (resource.data.erstelltVonUid == request.auth.uid || isAdmin());
    }

    // --- custody_rules: Standard-Betreuungsmuster (wiederkehrend), nur
    // Admin darf es ändern, alle aktiven Personen dürfen es lesen -------
    match /custody_rules/{ruleId} {
      allow read: if isSignedIn() && isActive();
      allow write: if isAdmin();
    }

    // --- alles andere: vorerst komplett gesperrt ------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
