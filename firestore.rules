rules_version = '2';

// ChaosKalender – Firestore-Sicherheitsregeln
// REGEL-VERSION: rules-v11-2026-10-06
//
// Neu in v11 (gegenüber v10):
//  * users_privat/{uid}: E-Mail und Telefonnummer für den Fall eines
//           vergessenen Passworts – nur die Person selbst und der Admin
//           können sie lesen; schreiben nur die Person selbst.
//
// Neu in v10 (gegenüber v8):
//  * users: jede Person darf selbst NUR zwei Felder ändern:
//           - usernameWunsch (den Namen selbst setzt der Admin),
//           - ntfyKanal (freiwilliger Push-Kanal für die App ntfy).
//
// Neu in v8 (gegenüber v7), alles Sicherheits-Härtung:
//  * users:  Registrierung nur mit gültigem Namen, keine Selbst-Änderungen mehr
//            (Änderungen nur durch den Admin).
//  * logs:   nur aktive Personen, feste Feldliste – kein beliebiger Inhalt mehr.
//  * custom_events: Info-Termine ändern nie die Betreuung; niemand kann sich selbst
//            bestätigen; nur genannte Bestätiger können bestätigen/ablehnen; andere
//            aktive Personen dürfen nur chatten (Chat darf nicht schrumpfen).
//  * event_overrides: Zeiten/Betreuung nur Janine, Andi, Admin; alle anderen nur Chat.
//  * slot_changes: Status ändern nur, wer gerade am Zug ist.
//  * Dokument-IDs nur aus harmlosen Zeichen.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn() && userDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == 'admin';
    }

    function isParentOrAdmin() {
      return isActive() && userDoc().data.role in ['janine', 'andi', 'admin'];
    }

    function okId(id) {
      return id.matches('[A-Za-z0-9_.-]{1,120}');
    }

    function okStr(v, n) {
      return v is string && v.size() <= n;
    }

    function okName(v) {
      return v is string && v.matches('[A-Za-zäöüÄÖÜéèàß0-9 _.,!?()-]{2,60}');
    }

    function numOrShort(v) {
      return v is number || (v is string && v.size() <= 12);
    }

    // --- users ---------------------------------------------------------
    match /users/{userId} {
      // Lesen: eigenes Profil, Admin oder jede AKTIVE Person (Namen/UIDs werden
      // z.B. für Änderungsanfragen gebraucht). Reine Profildaten.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isActive());

      // Registrierung: nur das EIGENE Dokument, zwingend "pending", ohne Rolle,
      // nur diese drei Felder, Name aus harmlosen Zeichen (2–60).
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['username', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && okStr(request.resource.data.username, 60)
                    && request.resource.data.username.matches('[A-Za-zäöüÄÖÜéèàß0-9 _.,!?()-]{2,60}')
                    && (!('createdAt' in request.resource.data) || okStr(request.resource.data.createdAt, 40));

      // Ändern (Freischalten, Rolle, Name) und Löschen: der Admin.
      // Selbst-Änderung: NUR ein Namens-Wunsch (den der Admin übernehmen
      // muss) und der eigene ntfy-Push-Kanal – kein Umbenennen, kein Hochstufen.
      allow update: if isAdmin() ||
                     (isSignedIn() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['usernameWunsch', 'ntfyKanal'])
                      && (request.resource.data.get('usernameWunsch', '') == ''
                          || okName(request.resource.data.get('usernameWunsch', '')))
                      && request.resource.data.get('ntfyKanal', '') is string
                      && request.resource.data.get('ntfyKanal', '').matches('[A-Za-z0-9_-]{0,64}'));
      allow delete: if isAdmin();
    }

    // --- logs: Login-/Geräte-Protokoll --------------------------------
    match /logs/{logId} {
      // Nur aktive Personen, nur über sich selbst, nur bekannte Felder mit
      // passenden Typen/Längen (kein beliebiger Inhalt, keine Riesen-Dokumente).
      allow create: if isActive()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'uid', 'typ', 'erwarteteRegelVersion', 'username', 'role', 'zeitpunkt',
                         'appVersion', 'url', 'sprache', 'zeitzone', 'online', 'geraet', 'userAgent',
                         'bildschirmBreite', 'bildschirmHoehe', 'fensterBreite', 'fensterHoehe',
                         'documentClientBreite', 'visualViewportScale', 'pixelRatio',
                         'textSkalierungsVerdacht', 'textSkalierungsDetails', 'details'
                       ])
                    && okStr(request.resource.data.typ, 40)
                    && request.resource.data.typ.matches('[a-z0-9_]{1,40}')
                    && (!('details' in request.resource.data) || okStr(request.resource.data.details, 4100))
                    && (!('username' in request.resource.data) || okStr(request.resource.data.username, 100))
                    && (!('role' in request.resource.data) || okStr(request.resource.data.role, 40))
                    && (!('url' in request.resource.data) || okStr(request.resource.data.url, 600))
                    && (!('userAgent' in request.resource.data) || okStr(request.resource.data.userAgent, 600))
                    && (!('bildschirmBreite' in request.resource.data) || numOrShort(request.resource.data.bildschirmBreite))
                    && (!('bildschirmHoehe' in request.resource.data) || numOrShort(request.resource.data.bildschirmHoehe))
                    && (!('fensterBreite' in request.resource.data) || numOrShort(request.resource.data.fensterBreite))
                    && (!('fensterHoehe' in request.resource.data) || numOrShort(request.resource.data.fensterHoehe))
                    && (!('textSkalierungsVerdacht' in request.resource.data) || numOrShort(request.resource.data.textSkalierungsVerdacht));
      // Lesen darf ausschließlich der Admin (Geräte-/Nutzungsdaten sind sensibel).
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- slot_changes: Änderungsanfragen zwischen den Elternteilen -----
    match /slot_changes/{changeId} {
      allow read: if isSignedIn() && (
                     isAdmin() ||
                     request.auth.uid == resource.data.angefragtVonUid ||
                     request.auth.uid == resource.data.angefragtAnUid
                   );
      // Anlegen: nur als "angefragtVon" über sich selbst, an eine existierende
      // andere Person, immer als "offen" (nie schon akzeptiert).
      allow create: if isActive() && okId(changeId)
                    && request.resource.data.angefragtVonUid == request.auth.uid
                    && request.resource.data.status == 'offen'
                    && request.resource.data.angefragtAnUid is string
                    && request.resource.data.angefragtAnUid != request.auth.uid
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.angefragtAnUid));
      // Ändern: nur die beiden Beteiligten; Beteiligte bleiben unverändert;
      // den Status ändern (akzeptieren/ablehnen/Gegenvorschlag) darf nur, wer
      // gerade am Zug ist – niemand kann seine eigene Anfrage selbst akzeptieren.
      allow update: if isActive() && (
                       isAdmin() || (
                         (request.auth.uid == resource.data.angefragtVonUid ||
                          request.auth.uid == resource.data.angefragtAnUid)
                         && request.resource.data.angefragtVonUid == resource.data.angefragtVonUid
                         && request.resource.data.angefragtAnUid == resource.data.angefragtAnUid
                         && (request.resource.data.status == resource.data.status ||
                             request.auth.uid == resource.data.get('aktuellAmZugUid', ''))
                       )
                     );
      allow delete: if isSignedIn() && (
                       isAdmin() ||
                       request.auth.uid == resource.data.angefragtVonUid ||
                       request.auth.uid == resource.data.angefragtAnUid
                     );
    }

    // --- event_overrides: verschobene/abgesagte Fixtermine (Schule, Hort,
    // Club, Bandprobe), Chats dazu und tagesgenaue Betreuungs-Ausnahmen
    // (Schlüssel "betreuung_<Datum>") --------------------------------
    match /event_overrides/{key} {
      allow read: if isActive();
      // Zeiten/Absagen/Betreuung: nur Janine, Andi und Admin. Alle anderen
      // aktiven Personen dürfen ausschließlich im Chat schreiben.
      allow create: if isActive() && okId(key)
                    && (isParentOrAdmin() || request.resource.data.keys().hasOnly(['chat']));
      allow update: if isActive()
                    && (isParentOrAdmin()
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat']));
      allow delete: if isParentOrAdmin();
    }

    // --- custom_events: frei eintragbare Termine ----------------------
    match /custom_events/{eventId} {
      allow read: if isActive();

      // Anlegen: als sich selbst; nur "info" oder "schwebend" (nie schon
      // "bestaetigt"); ein reiner Info-Termin ändert NIE die Betreuung;
      // noch keine Bestätigungen.
      allow create: if isActive() && okId(eventId)
                    && request.resource.data.erstelltVonUid == request.auth.uid
                    && request.resource.data.status in ['info', 'schwebend']
                    && okStr(request.resource.data.titel, 200)
                    && (request.resource.data.status == 'schwebend'
                        || request.resource.data.get('beeinflusstBetreuung', false) == false)
                    && request.resource.data.get('bestaetigtVon', []).size() == 0;

      allow update: if isActive() && (
        // Admin: alles.
        isAdmin() ||

        // Ersteller: darf bearbeiten, aber nicht die Herkunft ändern, sich nicht
        // selbst bestätigen, und einen Info-Termin nie mit Betreuungs-Wirkung
        // versehen. Ein bereits bestätigter Termin behält seine Zeit-/Betreuungs-
        // Daten, solange er "bestaetigt" bleibt (Änderung nur über neue Anfrage).
        (resource.data.erstelltVonUid == request.auth.uid
          && request.resource.data.erstelltVonUid == resource.data.erstelltVonUid
          && (request.resource.data.status != 'bestaetigt' || resource.data.status == 'bestaetigt')
          && (request.resource.data.status != 'info'
              || request.resource.data.get('beeinflusstBetreuung', false) == false)
          && !(resource.data.status == 'bestaetigt' && request.resource.data.status == 'bestaetigt'
               && request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'beeinflusstBetreuung', 'betreuungWer', 'datum', 'startDatum', 'endDatum',
                    'von', 'bis', 'mehrtaegig', 'bestaetigerUids']))) ||

        // Genannte Bestätiger: nur bestätigen/ablehnen (+ Chat), nur für sich
        // selbst, und "bestaetigt" nur, wenn wirklich alle Genannten bestätigt haben.
        (request.auth.uid in resource.data.get('bestaetigerUids', [])
          && resource.data.status == 'schwebend'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'bestaetigtVon', 'status', 'ablehnungsGrund', 'ablehnungGesehen', 'chat'])
          && request.resource.data.status in ['schwebend', 'bestaetigt', 'abgelehnt']
          && request.resource.data.get('bestaetigtVon', []).toSet()
               .difference(resource.data.get('bestaetigtVon', []).toSet()).hasOnly([request.auth.uid])
          && (request.resource.data.status != 'bestaetigt'
              || resource.data.get('bestaetigerUids', []).toSet()
                   .difference(request.resource.data.get('bestaetigtVon', []).toSet()).size() == 0)
          && request.resource.data.get('chat', []).size() >= resource.data.get('chat', []).size()) ||

        // Alle anderen aktiven Personen: nur Chat – und der darf nicht schrumpfen.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat'])
          && request.resource.data.get('chat', []).size() >= resource.data.get('chat', []).size())
      );

      // Löschen: nur Admin oder die Person, die den Termin erstellt hat.
      allow delete: if isActive() &&
                     (resource.data.erstelltVonUid == request.auth.uid || isAdmin());
    }

    // --- custody_rules: Standard-Betreuungsmuster; nur der Admin ändert ---
    match /custody_rules/{ruleId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // --- custody_exceptions: ALTE Sammlung, nur noch lesbar (die App schreibt
    // Betreuungs-Ausnahmen inzwischen in event_overrides). ---------------
    match /custody_exceptions/{datum} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // --- users_privat: Kontaktdaten (nur selbst + Admin) ---------------
    match /users_privat/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['email', 'telefon', 'geaendertAm'])
                            && okStr(request.resource.data.get('email', ''), 254)
                            && request.resource.data.get('telefon', '') is string
                            && request.resource.data.get('telefon', '').matches('[0-9 +()/.-]{0,30}')
                            && okStr(request.resource.data.get('geaendertAm', ''), 40);
      allow delete: if isAdmin();
    }

    // --- alles andere: komplett gesperrt -------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
